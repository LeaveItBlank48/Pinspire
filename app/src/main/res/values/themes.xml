<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <bool name="light_bars">true</bool>

    <style name="Theme.Pinspire" parent="Theme.Material3.DayNight.NoActionBar">
        <item name="colorPrimary">@color/ink</item>
        <item name="colorOnPrimary">@color/paper</item>
        <item name="colorPrimaryContainer">@color/surface2</item>
        <item name="colorOnPrimaryContainer">@color/ink</item>
        <item name="colorSecondary">@color/spark</item>
        <item name="colorOnSecondary">@color/on_spark</item>
        <item name="colorSecondaryContainer">@color/surface3</item>
        <item name="colorOnSecondaryContainer">@color/ink</item>
        <item name="colorTertiary">@color/spark</item>
        <item name="colorOnTertiary">@color/on_spark</item>
        <item name="colorTertiaryContainer">@color/spark_soft</item>
        <item name="colorOnTertiaryContainer">@color/ink</item>
        <item name="colorSurface">@color/paper</item>
        <item name="colorOnSurface">@color/ink</item>
        <item name="colorSurfaceVariant">@color/surface2</item>
        <item name="colorOnSurfaceVariant">@color/muted</item>
        <item name="colorSurfaceContainerLowest">@color/paper</item>
        <item name="colorSurfaceContainerLow">@color/paper</item>
        <item name="colorSurfaceContainer">@color/paper</item>
        <item name="colorSurfaceContainerHigh">@color/surface2</item>
        <item name="colorSurfaceContainerHighest">@color/surface2</item>
        <item name="colorOutline">@color/line_strong</item>
        <item name="colorOutlineVariant">@color/line</item>
        <item name="android:colorBackground">@color/paper</item>
        <item name="android:windowBackground">@color/paper</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLightStatusBar">@bool/light_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="o_mr1">@bool/light_bars</item>
        <item name="chipStyle">@style/Widget.Pinspire.Chip</item>
    </style>

    <style name="Widget.Pinspire.Chip" parent="Widget.Material3.Chip.Filter">
        <item name="chipStrokeWidth">0dp</item>
        <item name="chipBackgroundColor">@color/chip_bg</item>
        <item name="checkedIconVisible">false</item>
        <item name="android:textColor">@color/chip_text</item>
        <item name="chipCornerRadius">18dp</item>
        <item name="chipMinHeight">38dp</item>
    </style>

    <style name="Widget.Pinspire.NavIndicator" parent="Widget.Material3.BottomNavigationView.ActiveIndicator">
        <item name="android:color">@color/surface2</item>
    </style>

    <style name="ShapeAppearance.Pinspire.Pin" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">16dp</item>
    </style>

    <style name="ShapeAppearance.Pinspire.Large" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">24dp</item>
    </style>

    <style name="ShapeAppearance.Pinspire.Small" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>

    <style name="TextAppearance.Pinspire.Logo" parent="TextAppearance.Material3.HeadlineMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.06</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Pinspire.Title" parent="TextAppearance.Material3.HeadlineSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Pinspire.Section" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/ink</item>
    </style>

    <style name="TextAppearance.Pinspire.Overline" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.12</item>
        <item name="android:textAllCaps">true</item>
    </style>
</resources>
